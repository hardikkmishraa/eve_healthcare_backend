# Template for production deployment — copy to .env and fill in real values
# NEVER commit .env to version control

APP_NAME=EVE Healthcare API
ENVIRONMENT=production
DEBUG=false

DATABASE_URL=postgresql://eve_user:CHANGE_ME@postgres:5432/eve_healthcare
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_64_CHAR_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

PAYMENT_SUCCESS_RATE=0.8
WEBHOOK_SECRET_KEY=CHANGE_ME_WEBHOOK_SECRET
ENABLE_WEBHOOK_HMAC=true

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PAYMENT=20/minute
RATE_LIMIT_DEFAULT=100/minute

PENDING_BOOKING_TIMEOUT_MINUTES=15
CACHE_TTL_SECONDS=600

LOG_LEVEL=INFO
LOG_FORMAT=json
